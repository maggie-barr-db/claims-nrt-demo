flowchart TB

  subgraph TOP[" Access &amp; Source "]
    direction LR
    Users(["👥 Users / Analysts"]):::ext
    API(["⚙️ REST · CLI · SDK"]):::ext
    QNXT[("QNXT · SQL Server")]:::src
    QLIK["Qlik Replicate<br/>CDC I/U/D + change_seq"]:::cdc
    Users ~~~ API ~~~ QNXT
    QNXT --> QLIK
  end

  subgraph UC["🛡️ Unity Catalog — one governance layer over every asset below"]
    direction LR
    G1["Catalog / Schema"]:::gov
    G2["Lineage"]:::gov
    G3["Tags · RBAC"]:::gov
    G4["Predictive<br/>Optimization"]:::gov
    G5["Deletion Vectors ·<br/>Change Data Feed"]:::gov
    G1 ~~~ G2 ~~~ G3 ~~~ G4 ~~~ G5
  end

  subgraph PIPE["⚡ Lakeflow Declarative Pipeline — serverless + Photon"]
    direction LR
    LAND["📁 Landing Volume (S3)<br/>/landing/&lt;table&gt;/<br/>parquet"]:::land
    BRONZE["L0 Bronze · Auto Loader<br/>append-only raw CDC · CDF<br/><br/>⇉ 9 tables, parallel"]:::bronze
    SILVER["Silver · current-state<br/>APPLY CHANGES · SCD1<br/>liquid-cluster claim_id · DV<br/><br/>⇉ 9 tables, parallel"]:::silver
    GOLD["Gold · dimensional model (star)<br/>dims: provider · member · payer ·<br/>date · procedure · diagnosis<br/>facts: fact_claim_line (line grain) ·<br/>fact_claim (header) · agg_claims_daily<br/><br/>joins · explode · aggregate — not 1:1"]:::gold
    LAND --> BRONZE --> SILVER --> GOLD
  end

  subgraph CONS["Consumption"]
    direction LR
    R1["Genie"]:::cons
    R2["DBSQL"]:::cons
    R3["AI/BI Dashboards"]:::cons
    R1 ~~~ R2 ~~~ R3
  end

  TOP ~~~ UC
  UC ~~~ PIPE
  PIPE ~~~ CONS
  QLIK --> LAND
  LAND -. "file-arrival trigger · no always-on cost" .-> BRONZE
  GOLD --> CONS

