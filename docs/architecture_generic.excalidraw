    {
      "id": "t-321995",
      "type": "text",
      "x": 72,
      "y": 510,
      "width": 616,
      "height": 101,
      "angle": 0,
      "strokeColor": "#222222",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g-276668"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 497264643,
      "version": 1,
      "versionNonce": 1180378218,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u25a3  Streaming Table  \u2014  incremental; processes only new/changed\n      rows (cost \u221d change set).  Bronze, Silver, big keyed Gold facts.\n\n\u25c7  Materialized View  \u2014  query kept current; incremental-refresh\n      where supported, else full recompute (cost \u221d table size).\n      Dims, aggregates, low-churn Gold.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u25a3  Streaming Table  \u2014  incremental; processes only new/changed\n      rows (cost \u221d change set).  Bronze, Silver, big keyed Gold facts.\n\n\u25c7  Materialized View  \u2014  query kept current; incremental-refresh\n      where supported, else full recompute (cost \u221d table size).\n      Dims, aggregates, low-churn Gold.",
      "lineHeight": 1.3
    },
