      "version": 1,
      "versionNonce": 1514242534,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "keyed + high-churn + large        \u2192  Streaming Table\ndimension / reference / low-churn  \u2192  Materialized View\naggregation / rollup / DISTINCT    \u2192  MV\n        (incremental refresh, or recompute\n         only the touched partitions)\n\nLow change ratio \u2192 streaming wins.\nReprocessing a large fraction \u2192 full recompute can win.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "keyed + high-churn + large        \u2192  Streaming Table\ndimension / reference / low-churn  \u2192  Materialized View\naggregation / rollup / DISTINCT    \u2192  MV\n        (incremental refresh, or recompute\n         only the touched partitions)\n\nLow change ratio \u2192 streaming wins.\nReprocessing a large fraction \u2192 full recompute can win.",
      "lineHeight": 1.3
    },
